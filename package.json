{
  "name": "plinth",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node test/foundation.test.js",
    "test:db": "node --env-file-if-exists=.env test/postgres.test.js",
    "test:tenant": "node --test test/tenant.test.js",
    "test:http": "node --test test/http.test.js",
    "test:db:embedded": "node test/run-embedded.js",
    "dev": "node scripts/dev.js",
    "test:architecture": "node --test test/architecture.test.js",
    "verify": "npm test && npm run test:tenant && npm run test:http && npm run test:architecture && npm run test:db:embedded"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8"
  }
}
